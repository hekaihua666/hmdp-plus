# 复制为 .env 后按实际环境填写；.env 已被 .gitignore 忽略，切勿提交真实凭据。
# 本机开发：只需设置 DB_PASSWORD，其余都有默认值，可直接沿用 application.yaml 的默认值。

# ===== 数据库（MySQL，默认 3307 为 Docker 容器端口） =====
DB_URL=jdbc:mysql://127.0.0.1:3307/hmdp?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
# 必填：数据库密码，无默认值
DB_PASSWORD=

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 命令等待超时（故障时限制，避免长期占用锁/线程）
REDIS_COMMAND_TIMEOUT=2s

# ===== Elasticsearch =====
ES_HOST=127.0.0.1
ES_PORT=9200

# ===== RocketMQ =====
ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# ===== 秒杀（可选，一般用默认值即可） =====
SECKILL_REQUEST_TIMEOUT_SECONDS=600
SECKILL_PUBLISH_INTERVAL_SECONDS=60
